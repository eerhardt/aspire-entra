@inject UserPhotoService UserPhotos
@inject BlazorAuthenticationChallengeHandler ChallengeHandler

<AuthorizeView>
    <Authorized>
        @* A native disclosure element, so the menu opens and closes without JavaScript in statically rendered pages. *@
        <details class="user-menu dropdown">
            <summary class="btn btn-light border rounded-pill d-flex align-items-center gap-2 dropdown-toggle">
                @if (photoDataUrl is not null)
                {
                    <img src="@photoDataUrl" alt="" class="user-photo rounded-circle" />
                }
                @context.User.Identity?.Name
            </summary>
            <div class="dropdown-menu d-block shadow">
                <div class="px-3 py-2">
                    <div class="small text-body-secondary">Signed in as</div>
                    <div class="fw-semibold">@context.User.Identity?.Name</div>
                </div>
                <div class="dropdown-divider"></div>
                <form action="authentication/logout" method="post">
                    <AntiforgeryToken />
                    <input type="hidden" name="returnUrl" value="/" />
                    <button type="submit" class="dropdown-item">Sign out</button>
                </form>
            </div>
        </details>
    </Authorized>
    <NotAuthorized>
        <a href="authentication/login?returnUrl=/" class="nav-link">Log in</a>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private string? photoDataUrl;

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationState is null)
        {
            return;
        }

        var user = (await AuthenticationState).User;
        if (user.Identity?.IsAuthenticated != true)
        {
            return;
        }

        try
        {
            photoDataUrl = await UserPhotos.GetPhotoDataUrlAsync(user);
        }
        catch (Exception ex)
        {
            // Sends the user to sign in again when a Graph token can't be acquired silently, for example when
            // the user hasn't consented to the Graph permission yet. Other failures just leave the photo out.
            await ChallengeHandler.HandleExceptionAsync(ex);
        }
    }
}
